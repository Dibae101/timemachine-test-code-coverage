# APKs are large binaries; keep them out of the git object store.
# GitHub rejects any single file over 100 MB and the dataset carries ~40 APKs,
# so these go through Git LFS.
*.apk filter=lfs diff=lfs merge=lfs -text

# Coverage execution data is binary too and can be sizeable.
*.ec filter=lfs diff=lfs merge=lfs -text

# Compiled classes stay as ordinary git objects: they are small individually and
# number in the tens of thousands, which is exactly the case LFS handles badly.
*.class -text
