<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools"
	android:installLocation="auto"
	>

	<uses-permission
		android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
		tools:node="remove"
		/>
	<uses-permission android:name="android.permission.CAMERA"/>

	<uses-feature
		android:name="android.hardware.camera" android:required="false"
		/>
	<uses-feature
		android:name="android.hardware.camera.autofocus" android:required="false"
		/>
	<uses-feature
		android:name="android.hardware.camera.front" android:required="false"
		/>
	<uses-feature
		android:name="android.hardware.camera.front.autofocus" android:required="false"
		/>

	<application
		android:name="org.moire.opensudoku.OpenSudoku"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:requestLegacyExternalStorage="true"
		android:theme="@android:style/Theme.Translucent.NoTitleBar"
		android:supportsRtl="true"
		>
		<activity
			android:name=".gui.screen.title.TitleScreenActivity"
			android:exported="true"
			android:screenOrientation="fullUser"
			android:theme="@style/AppTheme.NoActionBar"
			>
			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>

				<category android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>
		</activity>
		<activity
			android:name=".gui.screen.folder_list.FolderListActivity"
			android:theme="@style/AppTheme.NoActionBar"
			/>
		<activity
			android:name=".gui.screen.puzzle_list.PuzzleListActivity"
			android:theme="@style/AppTheme.NoActionBar"
			/>
		<activity
			android:name=".gui.screen.puzzle_edit.PuzzleEditActivity"
			android:exported="false"
			android:label="@string/edit_puzzle"
			android:theme="@style/AppTheme.NoActionBar"
			>
			<intent-filter>
				<action android:name="android.intent.action.INSERT"/>
				<action android:name="android.intent.action.EDIT"/>

				<category android:name="android.intent.category.DEFAULT"/>
			</intent-filter>
		</activity>
		<activity android:name=".gui.importing.PuzzleImportActivity"
			android:exported="true"
			android:theme="@style/AppTheme.NoActionBar">
			<intent-filter>
				<category android:name="android.intent.category.DEFAULT"/>
				<category android:name="android.intent.category.BROWSABLE"/>

				<data android:scheme="content"/>
				<data android:mimeType="application/x-opensudoku"/>
				<data android:scheme="file"/>
				<data android:mimeType="application/x-opensudoku"/>
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.VIEW"/>

				<category android:name="android.intent.category.DEFAULT"/>
				<category android:name="android.intent.category.BROWSABLE"/>

				<data android:scheme="file"/>
				<data android:host="*"/>
				<data android:pathPattern=".*\\.sdm"/>
				<data android:mimeType="*/*"/>
				<data android:scheme="content"/>
				<data android:host="*"/>
				<data android:pathPattern=".*\\.sdm"/>
				<data android:mimeType="*/*"/>
				<data android:scheme="file"/>
				<data android:host="*"/>
				<data android:pathPattern=".*\\.opensudoku"/>
				<data android:mimeType="*/*"/>
				<data android:scheme="content"/>
				<data android:host="*"/>
				<data android:pathPattern=".*\\.opensudoku"/>
				<data android:mimeType="*/*"/>
			</intent-filter>
			<intent-filter>
				<action android:name="android.intent.action.SEND"/>

				<category android:name="android.intent.category.DEFAULT"/>

				<data android:mimeType="*/*"/>
			</intent-filter>
		</activity>
		<activity android:name=".gui.exporting.PuzzleExportActivity"
			android:theme="@style/AppTheme.NoActionBar"/>
		<activity android:name=".gui.rating.PuzzleRatingActivity"
			android:theme="@style/AppTheme.NoActionBar"/>
		<activity
			android:name=".gui.screen.game_play.SudokuPlayActivity"
			android:theme="@style/AppTheme.NoActionBar"
			/>
		<activity
			android:name=".gui.screen.SudokuScanActivity"
			android:label="@string/scan_puzzle"
			android:screenOrientation="fullUser"
			android:theme="@android:style/Theme.Translucent.NoTitleBar"
			android:exported="true"
			tools:ignore="DiscouragedApi"
			/>
		<activity
			android:name=".gui.screen.GameSettingsActivity"
			android:label="@string/game_settings"
			android:theme="@style/AppTheme.NoActionBar"
			/>

	        <receiver android:name=".JacocoInstrument.SMSInstrumentedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="edu.gatech.m3.emma.COLLECT_COVERAGE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
