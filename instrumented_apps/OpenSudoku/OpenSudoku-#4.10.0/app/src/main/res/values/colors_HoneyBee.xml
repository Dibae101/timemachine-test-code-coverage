<resources>
    <style name="AppTheme.HoneyBee" parent="AppThemeCommon">
        <!-- Grid lines (sector and cell) -->
        <item name="colorOutline">#89381D</item>

        <!-- Editable cells: text and background -->
        <item name="colorOnSurface">#cccccc</item>
        <item name="colorSurface">#000000</item>

        <!-- Not editable cells: text and background -->
        <item name="colorOnPrimaryContainer">#cccccc</item>
        <item name="colorPrimaryContainer">#592B06</item>

        <!-- Highlighted cells: text and background -->
        <item name="colorOnSecondaryContainer">#ffffff</item>
        <item name="colorSecondaryContainer">#C57514</item>

        <!-- Highlighted marks: text and background -->
        <item name="colorOnPrimary">#ffffff</item>
        <item name="colorPrimary">#E48411</item>

        <!-- Touched cells highlighting: text and background -->
        <item name="colorOnTertiaryContainer">#ffffff</item>
        <item name="colorTertiaryContainer">#8CF28045</item>

        <!-- Selected cell (color of the selection frame) -->
        <item name="colorSurfaceBright">#FFE47C</item>

        <!-- Invalid value cells: text and background -->
        <item name="colorOnErrorContainer">#ffb4ab</item>
        <item name="colorErrorContainer">#93000a</item>

        <!-- Even numbered box (editable cells): text and background  -->
        <item name="colorOnSurfaceVariant">?attr/colorOnSurface</item>
        <item name="colorSurfaceVariant">@android:color/transparent</item> <!-- transparent disables even/non-even difference -->
    </style>
</resources>
