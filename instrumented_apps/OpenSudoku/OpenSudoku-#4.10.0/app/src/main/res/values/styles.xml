<resources>
	<!-- Buttons that show a number the user can select to enter, like a keypad -->
	<style name="keypadButton" parent="@style/Widget.Material3.Button">
		<item name="android:checkable">true</item>
		<item name="cornerRadius">4dp</item>
		<item name="android:layout_width">0dp</item>
		<item name="android:layout_height">0dp</item>
		<item name="android:paddingLeft">10dp</item>
		<item name="android:paddingRight">10dp</item>
		<item name="android:paddingTop">10dp</item>
		<item name="android:paddingBottom">10dp</item>
		<item name="android:insetLeft">4dp</item>
		<item name="android:insetRight">4dp</item>
	</style>

	<!-- Buttons to switch between input modes -->

	<style name="popupButton" parent="@style/Widget.Material3.Button.IconButton">
		<item name="android:layout_width">@dimen/popup_button_size</item>
		<item name="android:layout_height">@dimen/popup_button_size</item>
		<item name="android:checkable">true</item>
		<item name="cornerRadius">4dp</item>
	</style>

	<!-- Support styles for customizing app UI theme. -->

</resources>
