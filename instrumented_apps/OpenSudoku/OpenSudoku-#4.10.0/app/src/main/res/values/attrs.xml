<resources>
	<declare-styleable name="SeekBarPreference">
		<attr name="min" format="integer"/>
		<attr name="max" format="integer"/>
		<attr name="value" format="integer"/>
		<attr name="valueFormat" format="string"/>
	</declare-styleable>

	<declare-styleable name="NumberButton">
		<!-- True if all numbers for this button are placed -->
		<attr name="all_numbers_placed" format="boolean"/>
	</declare-styleable>

	<attr name="colorValue1" format="color"/>
	<attr name="colorValue2" format="color"/>
	<attr name="colorValue3" format="color"/>
	<attr name="colorValue4" format="color"/>
	<attr name="colorValue5" format="color"/>
	<attr name="colorValue6" format="color"/>
	<attr name="colorValue7" format="color"/>
	<attr name="colorValue8" format="color"/>
	<attr name="colorValue9" format="color"/>
</resources>
