<resources>
	<style name="AppTheme" parent="AppThemeCommon" />

	<style name="AppThemeCommon" parent="Theme.Material3.DayNight.NoActionBar">
		<!-- all modes overrides -->
		<!-- colorPrimary: is defined in each theme, it is also used for example for selected theme indicator -->
		<item name="colorSecondary">?attr/colorPrimary</item> <!-- e.g. settings section titles -->

		<item name="colorPrimaryDark">?attr/colorOutline</item> <!-- this one is used for the system status bar -->
		<item name="android:statusBarColor">?attr/colorPrimaryDark</item>
		<item name="android:background">?attr/colorSurface</item> <!-- for compatibility with older Androids -->
		<item name="android:windowBackground">?attr/colorSurface</item>

		<!-- modes overrides -->
		<item name="android:textColor">?attr/colorOnSurface</item>
		<item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
		<item name="android:textColorLink">?attr/colorPrimary</item>

		<!-- dialogs etc. -->
		<item name="alertDialogTheme">@style/AppTheme.AlertDialog</item>
		<item name="android:itemTextAppearance">@style/myCustomMenuTextAppearance</item>
		<item name="android:textAppearancePopupMenuHeader">@style/myPopupHeader</item>

		<!-- Cell coloring custom colors -->
		<item name="colorValue1">#FFC0C0</item>
		<item name="colorValue2">#FFEDB2</item>
		<item name="colorValue3">#FEFFD2</item>
		<item name="colorValue4">#D8FFD8</item>
		<item name="colorValue5">#D2FFFF</item>
		<item name="colorValue6">#D2EBFF</item>
		<item name="colorValue7">#DAD2FF</item>
		<item name="colorValue8">#F0D2FF</item>
		<item name="colorValue9">#FFB0FF</item>

		<item name="windowActionBar">false</item>
		<item name="windowNoTitle">true</item>
	</style>

	<style name="myCustomMenuTextAppearance" parent="@android:style/TextAppearance.Widget.IconMenu.Item">
		<item name="android:textSize">17sp</item>
	</style>

	<style name="myPopupHeader" parent="TextAppearance.Material3.LabelLarge">
		<item name="android:textSize">17sp</item>
	</style>

	<style name="AppTheme.AlertDialog" parent="Theme.Material3.DayNight.Dialog.Alert">
		<item name="colorOnPrimary">?android:attr/textColor</item>
		<item name="android:textColorLink">#3737FF</item>
	</style>

	<style name="AppTheme.NoActionBar" parent="AppThemeCommon">
		<item name="windowActionBar">false</item>
		<item name="windowNoTitle">true</item>
	</style>

	<style name="NoActionBarOverlay" parent="">
		<item name="windowActionBar">false</item>
		<item name="windowNoTitle">true</item>
	</style>

	<style name="AppTheme.TextButton" parent="Widget.Material3.Button.TonalButton">
		<item name="android:textColor">@color/edit_button_text</item>
		<item name="backgroundTint">@color/edit_button_background</item>
		<item name="cornerRadius">4dp</item>
		<item name="android:minHeight">0dp</item>
		<item name="android:minWidth">0dp</item>
		<item name="android:paddingLeft">8dp</item>
		<item name="android:paddingRight">8dp</item>
		<item name="android:paddingTop">4dp</item>
		<item name="android:paddingBottom">4dp</item>
	</style>

	<style name="AppTheme.DarkDialog" parent="Theme.Material3.Dark.Dialog.Alert">
		<item name="android:textColor">?attr/colorOnSurface</item>
		<item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
		<item name="android:textColorLink">?attr/colorPrimary</item>
	</style>
	<style name="AppTheme.LightDialog" parent="Theme.Material3.Light.Dialog.Alert">
		<item name="android:textColor">?attr/colorOnSurface</item>
		<item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
		<item name="android:textColorLink">?attr/colorPrimary</item>
	</style>

	<style name="AppTheme.DarkOnly" parent="Theme.Material3.Dark.NoActionBar">
		<item name="android:textColor">?attr/colorOnSurface</item>
		<item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
		<item name="android:textColorLink">?attr/colorPrimary</item>
		<item name="alertDialogTheme">@style/AppTheme.DarkDialog</item>
	</style>
	<style name="AppTheme.LightOnly" parent="Theme.Material3.Light.NoActionBar">
		<item name="android:textColor">?attr/colorOnSurface</item>
		<item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
		<item name="android:textColorLink">?attr/colorPrimary</item>
		<item name="alertDialogTheme">@style/AppTheme.LightDialog</item>
	</style>
</resources>
