<resources>
	<style name="AppTheme.Latte" parent="AppThemeCommon">
		<!-- Grid lines (sector and cell) -->
		<item name="colorOutline">#955423</item>

		<!-- Editable cells: text and background -->
		<item name="colorOnSurface">#000000</item>
		<item name="colorSurface">#ffffff</item>

		<!-- Not editable cells: text and background -->
		<item name="colorOnPrimaryContainer">#000000</item>
		<item name="colorPrimaryContainer">#fffde7</item>

		<!-- Highlighted cells: text and background -->
		<item name="colorOnSecondaryContainer">#000000</item>
		<item name="colorSecondaryContainer">#E68A49</item>

		<!-- Highlighted marks: text and background -->
		<item name="colorOnPrimary">#000000</item>
		<item name="colorPrimary">#D77834</item>

		<!-- Touched cells highlighting: text and background -->
		<item name="colorOnTertiaryContainer">#000000</item>
		<item name="colorTertiaryContainer">#BF8864</item>

		<!-- Selected cell (color of the selection frame) -->
		<item name="colorSurfaceBright">#432D24</item>

		<!-- Invalid value cells: text and background -->
		<item name="colorOnErrorContainer">#410002</item>
		<item name="colorErrorContainer">#ffdad6</item>

		<!-- Even numbered box (editable cells): text and background  -->
		<item name="colorOnSurfaceVariant">?attr/colorOnSurface</item>
		<item name="colorSurfaceVariant">@android:color/transparent</item> <!-- transparent disables even/non-even difference -->

		<!-- Cell coloring custom colors -->
		<item name="colorValue1">#FFC0C0</item>
		<item name="colorValue2">#FFEDB2</item>
		<item name="colorValue3">#FEFFD2</item>
		<item name="colorValue4">#D8FFD8</item>
		<item name="colorValue5">#D2FFFF</item>
		<item name="colorValue6">#D2EBFF</item>
		<item name="colorValue7">#DAD2FF</item>
		<item name="colorValue8">#F0D2FF</item>
		<item name="colorValue9">#FFB0FF</item>
	</style>
</resources>
