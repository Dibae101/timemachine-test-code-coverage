<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	app:layout_constraintHorizontal_bias="0.5"
	>

	<androidx.gridlayout.widget.GridLayout
		android:id="@+id/keypad_grid"
		android:layout_width="0dp"
		android:layout_height="0dp"
		app:layout_constraintTop_toTopOf="parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintDimensionRatio="3:5"
		app:columnCount="3"
		app:rowCount="5"
		app:alignmentMode="alignBounds"
		app:rowOrderPreserved="false"
		app:columnOrderPreserved="false">

		<!-- Row 0 -->
		<org.moire.opensudoku.gui.NumberButton
			android:id="@+id/button_1"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="0"
			app:layout_column="0"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:text="1"
			tools:ignore="HardcodedText" />

		<org.moire.opensudoku.gui.NumberButton
			android:id="@+id/button_2"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="0"
			app:layout_column="1"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:text="2"
			tools:ignore="HardcodedText" />

		<org.moire.opensudoku.gui.NumberButton
			android:id="@+id/button_3"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="0"
			app:layout_column="2"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:text="3"
			tools:ignore="HardcodedText" />

		<!-- Row 1 -->
		<org.moire.opensudoku.gui.NumberButton
			android:id="@+id/button_4"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="1"
			app:layout_column="0"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:text="4"
			tools:ignore="HardcodedText" />

		<org.moire.opensudoku.gui.NumberButton
			android:id="@+id/button_5"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="1"
			app:layout_column="1"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:text="5"
			tools:ignore="HardcodedText" />

		<org.moire.opensudoku.gui.NumberButton
			android:id="@+id/button_6"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="1"
			app:layout_column="2"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:text="6"
			tools:ignore="HardcodedText" />

		<!-- Row 2 -->
		<org.moire.opensudoku.gui.NumberButton
			android:id="@+id/button_7"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="2"
			app:layout_column="0"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:text="7"
			tools:ignore="HardcodedText" />

		<org.moire.opensudoku.gui.NumberButton
			android:id="@+id/button_8"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="2"
			app:layout_column="1"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:text="8"
			tools:ignore="HardcodedText" />

		<org.moire.opensudoku.gui.NumberButton
			android:id="@+id/button_9"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="2"
			app:layout_column="2"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:text="9"
			tools:ignore="HardcodedText" />

		<!-- Row 3 -->
		<org.moire.opensudoku.gui.IconButton
			android:id="@+id/enter_number"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="3"
			app:layout_column="0"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:contentDescription="@string/cell_value"
			app:icon="@drawable/ic_enter_number"
			app:iconGravity="textStart"
			app:iconPadding="0dp" />

		<org.moire.opensudoku.gui.IconButton
			android:id="@+id/primary_mark"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="3"
			app:layout_column="1"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:contentDescription="@string/primary_marks"
			app:icon="@drawable/ic_primary_mark"
			app:iconGravity="textStart"
			app:iconPadding="0dp" />

		<org.moire.opensudoku.gui.IconButton
			android:id="@+id/secondary_mark"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="3"
			app:layout_column="2"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			android:contentDescription="@string/secondary_mark"
			app:icon="@drawable/ic_secondary_mark"
			app:iconGravity="textStart"
			app:iconPadding="0dp" />

		<!-- Row 4 -->
		<org.moire.opensudoku.gui.IconButton
			android:id="@+id/button_clear"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="4"
			app:layout_column="0"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			app:icon="@drawable/ic_eraser"
			app:iconGravity="textStart"
			app:iconTint="?attr/colorOnSurface"
			app:iconPadding="0dp"
			android:checkable="true" />

		<org.moire.opensudoku.gui.IconButton
			android:id="@+id/background_color"
			style="@style/keypadButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="4"
			app:layout_column="1"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			app:icon="@drawable/ic_background_color"
			app:iconGravity="textStart"
			app:iconPadding="0dp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/switch_input_mode"
			style="@style/Widget.Material3.Button.TonalButton"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:layout_row="4"
			app:layout_column="2"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			app:layout_gravity="fill"
			app:cornerRadius="4dp"
			android:textSize="16sp"
			app:autoSizeTextType="uniform"
			app:autoSizeMinTextSize="8sp"
			app:autoSizeMaxTextSize="16sp"
			android:padding="0dp"
			android:insetLeft="4dp"
			android:insetRight="4dp"
			android:insetTop="0dp"
			android:insetBottom="0dp" />

	</androidx.gridlayout.widget.GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
