<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:background="?attr/colorSurface"
	>

	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/app_bar_layout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@android:color/transparent"
		app:elevation="0dp">

		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="?attr/actionBarSize"
			android:background="@android:color/transparent" />

	</com.google.android.material.appbar.AppBarLayout>

	<ProgressBar
		android:id="@+id/progress_spinner"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="end"
		android:indeterminate="true"
		android:visibility="gone" />

	<androidx.recyclerview.widget.RecyclerView
		android:id="@+id/folder_list_recycler"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:drawSelectorOnTop="false"
		/>

	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@android:color/darker_gray"
		android:layout_marginTop="4dp"
		android:layout_marginBottom="4dp"
		/>

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="center"
		android:text="@string/get_more_puzzles_online"
		/>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		>

		<Button
			android:id="@+id/get_more_puzzles_from_os1"
			style="@style/Widget.Material3.Button.TextButton.Icon"
			app:icon="@drawable/ic_baseline_download"
			app:iconTint="?android:attr/textColorLink"
			android:textColor="?android:attr/textColorLink"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:text="@string/open_sudoku_1"
			/>

		<Button
			android:id="@+id/get_more_puzzles_from_sepb"
			style="@style/Widget.Material3.Button.TextButton.Icon"
			app:icon="@drawable/ic_baseline_download"
			app:iconTint="?android:attr/textColorLink"
			android:textColor="?android:attr/textColorLink"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:text="@string/sudoku_exchange_puzzle_bank"
			/>

		<Button
			android:id="@+id/get_more_puzzles_from_sudocue"
			style="@style/Widget.Material3.Button.TextButton.Icon"
			app:icon="@drawable/ic_baseline_download"
			app:iconTint="?android:attr/textColorLink"
			android:textColor="?android:attr/textColorLink"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:text="@string/sudocue"
			/>
	</LinearLayout>
</LinearLayout>
