<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="6dp"
	>

	<org.moire.opensudoku.gui.SudokuBoardView
		android:id="@+id/board_view"
		android:layout_width="100sp"
		android:layout_height="100sp"
		android:layout_marginEnd="6dp"
		android:layout_marginTop="0dp"/>

	<TextView
		android:id="@+id/state"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_toEndOf="@id/board_view"
		android:textAppearance="?android:attr/textAppearanceSmall"
		/>

	<TextView
		android:id="@+id/mistakes_and_time"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="8sp"
		android:layout_toEndOf="@id/state"
		android:gravity="end"
		android:textAppearance="?android:attr/textAppearanceSmall"
		/>

	<TextView
		android:id="@+id/last_played"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_below="@+id/state"
		android:layout_marginTop="0sp"
		android:layout_toEndOf="@id/board_view"
		android:textSize="12sp"
		/>

	<TextView
		android:id="@+id/created"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_below="@+id/last_played"
		android:layout_marginTop="0sp"
		android:layout_toEndOf="@id/board_view"
		android:textSize="12sp"
		/>

	<TextView
		android:id="@+id/rating"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_below="@+id/created"
		android:layout_marginTop="0sp"
		android:layout_toEndOf="@id/board_view"
		android:textSize="12sp"
		/>

	<TextView
		android:id="@+id/user_note"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_below="@+id/rating"
		android:layout_marginTop="0sp"
		android:layout_toEndOf="@id/board_view"
		android:textSize="12sp"
		/>

	<TextView
		android:id="@+id/suid"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_below="@+id/user_note"
		android:layout_marginTop="0sp"
		android:layout_toEndOf="@id/board_view"
		android:maxLines="1"
		android:ellipsize="end"
		android:textSize="12sp"
		/>
</RelativeLayout>
