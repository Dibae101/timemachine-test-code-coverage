<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	>

	<LinearLayout
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="4dp"
		>

		<TableLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			>

			<TableRow
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				>

				<org.moire.opensudoku.gui.NumberButton
					android:id="@+id/button_1"
					style="@style/popupButton"
					android:text="1"
					tools:ignore="HardcodedText"
					/>

				<org.moire.opensudoku.gui.NumberButton
					android:id="@+id/button_2"
					style="@style/popupButton"
					android:text="2"
					tools:ignore="HardcodedText"
					/>

				<org.moire.opensudoku.gui.NumberButton
					android:id="@+id/button_3"
					style="@style/popupButton"
					android:text="3"
					tools:ignore="HardcodedText"
					/>

				<org.moire.opensudoku.gui.IconButton
					android:id="@+id/enter_number"
					style="@style/popupButton"
					android:contentDescription="@string/cell_value"
					app:icon="@drawable/ic_enter_number"
					app:iconGravity="textStart"
					/>
			</TableRow>

			<TableRow
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				>

				<org.moire.opensudoku.gui.NumberButton
					android:id="@+id/button_4"
					style="@style/popupButton"
					android:text="4"
					tools:ignore="HardcodedText"
					/>

				<org.moire.opensudoku.gui.NumberButton
					android:id="@+id/button_5"
					style="@style/popupButton"
					android:text="5"
					tools:ignore="HardcodedText"
					/>

				<org.moire.opensudoku.gui.NumberButton
					android:id="@+id/button_6"
					style="@style/popupButton"
					android:text="6"
					tools:ignore="HardcodedText"
					/>

				<org.moire.opensudoku.gui.IconButton
					android:id="@+id/primary_mark"
					style="@style/popupButton"
					android:contentDescription="@string/primary_marks"
					app:icon="@drawable/ic_primary_mark"
					app:iconGravity="textStart"
					/>
			</TableRow>

			<TableRow
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				>

				<org.moire.opensudoku.gui.NumberButton
					android:id="@+id/button_7"
					style="@style/popupButton"
					android:text="7"
					tools:ignore="HardcodedText"
					/>

				<org.moire.opensudoku.gui.NumberButton
					android:id="@+id/button_8"
					style="@style/popupButton"
					android:text="8"
					tools:ignore="HardcodedText"
					/>

				<org.moire.opensudoku.gui.NumberButton
					android:id="@+id/button_9"
					style="@style/popupButton"
					android:text="9"
					tools:ignore="HardcodedText"
					/>

				<org.moire.opensudoku.gui.IconButton
					android:id="@+id/secondary_mark"
					style="@style/popupButton"
					android:contentDescription="@string/secondary_mark"
					app:icon="@drawable/ic_secondary_mark"
					app:iconGravity="textStart"
					/>
			</TableRow>

			<TableRow
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				>

				<View
					android:layout_width="0dp"
					android:layout_height="0dp"
					/>

				<View
					android:layout_width="0dp"
					android:layout_height="0dp"
					/>

				<View
					android:layout_width="0dp"
					android:layout_height="0dp"
					/>

				<org.moire.opensudoku.gui.IconButton
					android:id="@+id/background_color"
					style="@style/popupButton"
					android:contentDescription="@string/background"
					app:icon="@drawable/ic_background_color"
					app:iconGravity="textStart"
					/>
			</TableRow>
		</TableLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:orientation="horizontal"
			>

			<Button
				android:id="@+id/button_clear"
				style="@style/AppTheme.TextButton"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/clear"
				/>

			<Button
				android:id="@+id/button_close"
				style="@style/AppTheme.TextButton"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/close"
				/>
		</LinearLayout>

	</LinearLayout>
</ScrollView>
