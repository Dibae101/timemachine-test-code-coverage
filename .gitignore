.DS_Store
.idea*
.env

# ---------------------------------------------------------------------------
# Gradle / build output.
#
# The instrumented apps are rebuilt locally, and their build directories total
# several GB. They are excluded wholesale, with ONE deliberate exception: the
# compiled .class directories named in each app's class_files.json are required
# for Jacoco to turn probe data into line coverage, so those are force-added
# (git add -f). Not shipping them is the exact gap that made coverage read 0%
# in the original repo.
# ---------------------------------------------------------------------------
**/build/
.gradle/
**/.gradle/
local.properties
*.iml
.kotlin/

# Python
__pycache__/
*.pyc

# Logs and scratch output from dataset building / test runs
*.log
dataset_builder/logs/
dataset_builder/__pycache__/
fuzzingandroid/FuzzerEngine/fuzzerengine/temp

# Emulator snapshots are 1.3 GB each and are regenerated per run
*.avd/snapshots/
